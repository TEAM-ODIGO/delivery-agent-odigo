# 복사해서 .env로 쓰세요. .env는 커밋하지 않습니다.
E_DATABASE_URL=sqlite:///./e.db
# 서비스 간 인증 토큰: 모놀리스의 INTERNAL_SERVICE_TOKEN과 같은 값
INTERNAL_SERVICE_TOKEN=change-me-dev-only
# D-06(결제 직전 검증)을 부를 모놀리스 주소
D_URL=http://localhost:8000
# 모의 기관 결과: APPROVE(기본) / DECLINE / UNKNOWN(승인됐지만 응답 유실) / LOST(조회도 불가)
E_MOCK_MODE=APPROVE
# 환불 결과: REFUNDED / FAILED
E_MOCK_REFUND_MODE=REFUNDED
# 1이면 E-01 요청 헤더 X-Mock-Outcome으로 결과를 고를 수 있음 (시연·테스트 전용)
E_ALLOW_MOCK_OVERRIDE=
# E-02·E-03을 읽을 때 UNKNOWN 건을 기관 조회(E-08)로 확정할지
E_RECONCILE_ON_READ=1
# 미확정 거래 자동 대사 간격(초), 0이면 끔
E_RECONCILE_SECONDS=0
# NFC 실물 카드(로컬 확장). 둘 다 비우면 NFC 확인 안 함. 쉼표로 여러 장
#   E_NFC_TOKENS: 카드에 쓴 URL(http://PC주소:5173/tap?t=토큰)의 토큰 → 아이폰·안드로이드 모두
#   E_NFC_CARDS : 카드 일련번호(UID) → 안드로이드 크롬만
E_NFC_TOKENS=CARD001=odigo-card-001-change-me
E_NFC_CARDS=CARD001=04:2C:98:1A:32:24:91
