# 복사해서 .env로 쓰세요. .env는 커밋하지 않습니다.
DATABASE_URL=sqlite:///./dev.db
# PostgreSQL (docker compose up -d 후)
# DATABASE_URL=postgresql+psycopg://delivery:delivery@localhost:5432/delivery
# 서비스 간 인증 토큰 (Authorization: Bearer ...)
INTERNAL_SERVICE_TOKEN=change-me-dev-only
APPROVAL_TTL_MINUTES=10

# C(혜택) 서버를 따로 띄워 함께 돌려 볼 때만 채운다. 비우면 D 임시 규칙 사용
C_BENEFIT_URL=

# --- O (오케스트레이터) ---
# MVP 1 임시 로그인 "토큰:user_id" (화면이 Authorization: Bearer 토큰으로 보냄)
DEV_USER_TOKENS=dev-token-U001:U001,dev-token-U002:U002
# O-04 단계 이력 조회(관리자). 비우면 아무도 못 봄
ADMIN_ACCESS_TOKEN=
# E 서버 주소. 비우면 같은 프로세스의 가짜 E (scripts/fake_e_server.py를 띄우면 http://localhost:8002)
E_PAYMENT_URL=http://localhost:8002
# 별도 e-payment의 요청별 모의 결과를 시연할 때만 1 (E 쪽 E_ALLOW_MOCK_OVERRIDE=1도 필요)
O_DEMO_E_OVERRIDE=
# 결제 미확정 확인·B-08 재전송 주기(초), 0이면 끔
ORCHESTRATOR_RECONCILE_SECONDS=60
ORCHESTRATOR_RETRY_DELAY=0.2

# --- C (혜택) ---
# 1이면 진짜 C 대신 가짜 C(app/fakes/benefit.py)를 쓴다 (C 없이 O·D만 시험할 때)
USE_FAKE_C=
# C의 서비스·관리자 토큰은 위의 INTERNAL_SERVICE_TOKEN, ADMIN_ACCESS_TOKEN을 같이 쓴다
# E-11(원장) 서버 주소. 비우면 C의 mock 원장 사용
E_BASE_URL=

# --- 진짜 A·B 연결 (기본: 진짜 A·B 사용) ---
# 1이면 진짜 A·B 대신 가짜(app/fakes)를 쓴다. 가짜 B는 가짜 A의 식당(STORE101…)과만 짝이 맞는다.
USE_FAKE_A=
USE_FAKE_B=
# B가 만드는 견적 유효시간(초)
ORDERING_QUOTE_TTL_SECONDS=1800
# A의 LLM(Ollama). 꺼져 있거나 Ollama가 없으면 규칙 기반 추출로 동작한다
LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# C가 E-11(결제수단 원장)을 진짜 E에서 읽게 하려면 (비우면 C의 mock 원장)
E_BASE_URL=http://localhost:8002
