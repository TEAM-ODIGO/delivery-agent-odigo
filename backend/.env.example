# 복사해서 .env로 쓰세요. .env는 커밋하지 않습니다.
DATABASE_URL=sqlite:///./dev.db
# PostgreSQL (docker compose up -d 후)
# DATABASE_URL=postgresql+psycopg://delivery:delivery@localhost:5432/delivery
# 서비스 간 인증 토큰 (Authorization: Bearer ...)
INTERNAL_SERVICE_TOKEN=change-me-dev-only
APPROVAL_TTL_MINUTES=10

# C(혜택) 서버를 따로 띄워 함께 돌려 볼 때만 채운다. 비우면 D 임시 규칙 사용
C_BENEFIT_URL=

# --- O (오케스트레이터) ---
# MVP 1 임시 로그인 "토큰:user_id" (화면이 Authorization: Bearer 토큰으로 보냄)
DEV_USER_TOKENS=dev-token-U001:U001,dev-token-U002:U002
# O-04 단계 이력 조회(관리자). 비우면 아무도 못 봄
ADMIN_ACCESS_TOKEN=
# E 서버 주소. 비우면 같은 프로세스의 가짜 E (scripts/fake_e_server.py를 띄우면 http://localhost:8002)
E_PAYMENT_URL=http://localhost:8002
# 별도 e-payment의 요청별 모의 결과를 시연할 때만 1 (E 쪽 E_ALLOW_MOCK_OVERRIDE=1도 필요)
O_DEMO_E_OVERRIDE=
# 결제 미확정 확인·B-08 재전송 주기(초), 0이면 끔
ORCHESTRATOR_RECONCILE_SECONDS=60
ORCHESTRATOR_RETRY_DELAY=0.2

# --- C (혜택) ---
# 1이면 진짜 C 대신 가짜 C(app/fakes/benefit.py)를 쓴다 (C 없이 O·D만 시험할 때)
USE_FAKE_C=
# C의 서비스·관리자 토큰은 위의 INTERNAL_SERVICE_TOKEN, ADMIN_ACCESS_TOKEN을 같이 쓴다
# E-11(원장) 서버 주소. 비우면 C의 mock 원장 사용 (E 잔액과 어긋남)
# 같은 이름을 두 번 쓰지 말 것: uv --env-file은 먼저 나온 값을 쓴다
E_BASE_URL=http://localhost:8002

# --- 진짜 A·B 연결 (기본: 진짜 A·B 사용) ---
# 1이면 진짜 A·B 대신 가짜(app/fakes)를 쓴다. 가짜 B는 가짜 A의 식당(STORE101…)과만 짝이 맞는다.
USE_FAKE_A=
USE_FAKE_B=
# B가 만드는 견적 유효시간(초)
ORDERING_QUOTE_TTL_SECONDS=1800
# A의 LLM(Ollama). 꺼져 있거나 Ollama가 없으면 규칙 기반 추출로 동작한다
LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b


# 요기요 장바구니 담기 (O-13/O-14). 요기요 주문·결제는 누르지 않는다.
# fake(기본, 요기요 접속 없이 시연) | real(진짜 요기요, 브라우저는 첫 담기 때 자동 설치) | off
# 요기요 연동을 보려면: YOGIYO_CART_MODE=real
YOGIYO_CART_MODE=fake
# 0=브라우저 창을 띄움(기본). 1=창 없이: 요기요가 Access Denied로 막으므로 쓰지 않는다
YOGIYO_CART_HEADLESS=0
# 창을 띄운 경우(HEADLESS=0) 새 주문을 시작할 때까지 요기요 창을 열어 둔다
YOGIYO_CART_KEEP_BROWSER=1
# KEEP_BROWSER=0일 때만: 끝난 뒤 열어 둘 시간(초)
YOGIYO_CART_KEEP_OPEN_SECONDS=0
# 비우면 Playwright Chromium, chrome이면 설치된 Chrome
YOGIYO_CART_BROWSER=
# 캡처 저장 폴더
YOGIYO_CART_DIR=cart_runs

# 요기요 실시간 식당 확인 (O-15/O-16). 후보를 보여 줄 때 상위 후보가 지금 주문 가능한지 확인한다.
# fake(기본, 요기요 접속 없이 시연: #요기요닫힘 #요기요가격변경 #요기요전부닫힘) | real | off(확인 안 함)
LIVE_CHECK_MODE=fake
# A에서 받는 후보 수 (화면에는 통과한 후보 중 앞의 LIVE_CHECK_WANT곳)
LIVE_CHECK_TOP_N=6
# 통과(주문 가능·가격만 바뀜)가 이만큼이면 나머지는 확인하지 않음
LIVE_CHECK_WANT=3
# 동시에 여는 요기요 탭 수
LIVE_CHECK_CONCURRENCY=3
# 식당 하나에서 메뉴를 기다리는 시간(초)
LIVE_CHECK_TIMEOUT_SECONDS=8
# real 모드: 이 시간(분) 안에 확인한 식당은 다시 열지 않음
LIVE_CHECK_CACHE_MINUTES=15
